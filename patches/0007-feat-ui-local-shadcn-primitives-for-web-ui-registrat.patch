diff --git a/packages/web-ui-registration/src/components/FormCallout.tsx b/packages/web-ui-registration/src/components/FormCallout.tsx
new file mode 100644
index 0000000..7160fab
--- /dev/null
+++ b/packages/web-ui-registration/src/components/FormCallout.tsx
@@ -0,0 +1,49 @@
+import { AlertTriangle, CheckCircle2, Info, XCircle } from 'lucide-react';
+import type { HTMLAttributes, ReactNode } from 'react';
+
+import { cn } from '../lib/utils';
+
+export type FormCalloutType = 'danger' | 'warning' | 'success' | 'info';
+
+export type FormCalloutProps = HTMLAttributes<HTMLDivElement> & {
+	type?: FormCalloutType;
+	icon?: 'mail' | boolean;
+	children: ReactNode;
+};
+
+// Tailwind's stock red/amber/emerald/blue palette, not Eprisi tokens: no
+// status colors were sampled from the mockups (see eprisi-theme/tokens.json
+// color.status — all null), so this falls back to defaults instead of
+// inventing brand values.
+const typeStyles: Record<FormCalloutType, string> = {
+	danger: 'ep-border-red-200 ep-bg-red-50 ep-text-red-700',
+	warning: 'ep-border-amber-200 ep-bg-amber-50 ep-text-amber-700',
+	success: 'ep-border-emerald-200 ep-bg-emerald-50 ep-text-emerald-700',
+	info: 'ep-border-blue-200 ep-bg-blue-50 ep-text-blue-700',
+};
+
+const typeIcons: Record<FormCalloutType, typeof Info> = {
+	danger: XCircle,
+	warning: AlertTriangle,
+	success: CheckCircle2,
+	info: Info,
+};
+
+export const FormCallout = ({ type = 'info', className, children, ...props }: FormCalloutProps) => {
+	const Icon = typeIcons[type];
+	return (
+		<div
+			className={cn(
+				'ep-flex ep-items-start ep-gap-2 ep-rounded-sm ep-border ep-p-3 ep-text-p1',
+				typeStyles[type],
+				className,
+			)}
+			{...props}
+		>
+			<Icon className='ep-mt-0.5 ep-h-4 ep-w-4 ep-shrink-0' />
+			<div>{children}</div>
+		</div>
+	);
+};
+
+export default FormCallout;
diff --git a/packages/web-ui-registration/src/components/ui/button.tsx b/packages/web-ui-registration/src/components/ui/button.tsx
new file mode 100644
index 0000000..686dc45
--- /dev/null
+++ b/packages/web-ui-registration/src/components/ui/button.tsx
@@ -0,0 +1,35 @@
+import { cva, type VariantProps } from 'class-variance-authority';
+import type { ButtonHTMLAttributes } from 'react';
+import { forwardRef } from 'react';
+
+import { cn } from '../../lib/utils';
+
+const buttonVariants = cva(
+	'ep-inline-flex ep-items-center ep-justify-center ep-gap-2 ep-whitespace-nowrap ep-rounded-md ep-text-p1 ep-font-medium ep-transition-colors focus-visible:ep-outline-none focus-visible:ep-ring-2 focus-visible:ep-ring-brand-500 focus-visible:ep-ring-offset-2 disabled:ep-pointer-events-none disabled:ep-opacity-50',
+	{
+		variants: {
+			variant: {
+				default: 'ep-bg-brand-600 ep-text-font-on-primary hover:ep-bg-brand-700',
+				outline: 'ep-border ep-border-stroke-light ep-bg-transparent ep-text-font-default hover:ep-bg-surface-tint',
+				ghost: 'ep-text-font-default hover:ep-bg-surface-tint',
+				link: 'ep-h-auto ep-p-0 ep-text-brand-600 ep-underline-offset-4 hover:ep-underline',
+			},
+			size: {
+				default: 'ep-h-11 ep-px-4 ep-py-2',
+				sm: 'ep-h-9 ep-rounded-sm ep-px-3',
+				lg: 'ep-h-12 ep-rounded-md ep-px-8',
+			},
+		},
+		defaultVariants: {
+			variant: 'default',
+			size: 'default',
+		},
+	},
+);
+
+export type ButtonProps = ButtonHTMLAttributes<HTMLButtonElement> & VariantProps<typeof buttonVariants>;
+
+export const Button = forwardRef<HTMLButtonElement, ButtonProps>(({ className, variant, size, type = 'button', ...props }, ref) => (
+	<button type={type} className={cn(buttonVariants({ variant, size, className }))} ref={ref} {...props} />
+));
+Button.displayName = 'Button';
