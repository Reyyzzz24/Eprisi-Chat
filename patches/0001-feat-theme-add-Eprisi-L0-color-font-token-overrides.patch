+++ b/apps/meteor/app/theme/client/imports/general/eprisi-fonts.css
@@ -0,0 +1,51 @@
+/* Eprisi theme — self-hosted fonts (no external CDN calls at runtime).
+   Source: Google Fonts (IBM Plex Sans, Plus Jakarta Sans), latin + latin-ext subset,
+   fetched once and vendored under public/fonts/eprisi/. See eprisi-theme/README.md. */
+
+@font-face {
+	font-family: 'IBM Plex Sans';
+	font-style: normal;
+	font-weight: 400;
+	font-display: swap;
+	src: url('/fonts/eprisi/IBMPlexSans-Regular.woff2') format('woff2');
+}
+
+@font-face {
+	font-family: 'IBM Plex Sans';
+	font-style: normal;
+	font-weight: 500;
+	font-display: swap;
+	src: url('/fonts/eprisi/IBMPlexSans-Medium.woff2') format('woff2');
+}
+
+@font-face {
+	font-family: 'IBM Plex Sans';
+	font-style: normal;
+	font-weight: 600;
+	font-display: swap;
+	src: url('/fonts/eprisi/IBMPlexSans-SemiBold.woff2') format('woff2');
+}
+
+@font-face {
+	font-family: 'IBM Plex Sans';
+	font-style: normal;
+	font-weight: 700;
+	font-display: swap;
+	src: url('/fonts/eprisi/IBMPlexSans-Bold.woff2') format('woff2');
+}
+
+@font-face {
+	font-family: 'Plus Jakarta Sans';
+	font-style: normal;
+	font-weight: 600;
+	font-display: swap;
+	src: url('/fonts/eprisi/PlusJakartaSans-SemiBold.woff2') format('woff2');
+}
+
+@font-face {
+	font-family: 'Plus Jakarta Sans';
+	font-style: normal;
+	font-weight: 700;
+	font-display: swap;
+	src: url('/fonts/eprisi/PlusJakartaSans-Bold.woff2') format('woff2');
+}
diff --git a/apps/meteor/app/theme/client/imports/general/eprisi-tokens.css b/apps/meteor/app/theme/client/imports/general/eprisi-tokens.css
new file mode 100644
index 0000000..377ef9c
--- /dev/null
+++ b/apps/meteor/app/theme/client/imports/general/eprisi-tokens.css
@@ -0,0 +1,110 @@
+/* Eprisi theme — L0 token override.
+ *
+ * Loaded via main.css AFTER fuselage.css, so these plain declarations win the
+ * cascade over Fuselage's *static* CSS custom-property fallbacks purely by
+ * source order — no `!important` needed for that part.
+ *
+ * IMPORTANT CAVEAT (documented, not yet empirically verified against a live
+ * DOM — see GATE 2 report): Fuselage's <PaletteStyleTag> (used in
+ * MainLayoutStyleTags.tsx) also writes `--rcx-color-*` at runtime via a
+ * React-portaled <style> tag, inserted with
+ *   head.insertBefore(styleElement, document.getElementById('rcx-styles') || head.lastChild)
+ * This app has no `#rcx-styles` anchor, so the dynamic tag lands right before
+ * whatever was `head.lastChild` at first mount. Our bundled main.css normally
+ * loads earlier in <head>, so this SHOULD still resolve in our favor by
+ * source order — but this must be confirmed with the dev server running
+ * (GATE 6, or sooner if GATE 2 screenshots are taken). If verification shows
+ * the dynamic style wins instead, escalate specificity first (e.g. repeat the
+ * selector: `.rcx-content--main.rcx-content--main`) before reaching for
+ * `!important`, per the project's CSS rules.
+ *
+ * Values sourced from eprisi-theme/tokens.json — see that file for full
+ * pixel-sampling provenance of every color below.
+ */
+
+:root {
+	/* -- typography -------------------------------------------------- */
+	/* Body/regular text: replaces Fuselage's Inter default app-wide. */
+	--rcx-font-family-sans: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu,
+		Cantarell, 'Helvetica Neue', 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Meiryo UI', Arial,
+		sans-serif;
+
+	/* Heading font has no equivalent Fuselage token (Box's fontScale prop
+	   does not consume a CSS custom property) — exposed here as an Eprisi-only
+	   variable for L3 components (Tailwind `font-heading`, shadcn Card/Form
+	   titles) to consume explicitly. Does NOT retheme existing Fuselage
+	   headings across the rest of the app (out of L0 reach; see GATE 2 report). */
+	--ep-font-family-heading: 'Plus Jakarta Sans', 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI',
+		Roboto, sans-serif;
+
+	/* -- light-theme surface/font/stroke defaults --------------------- */
+	--rcx-color-surface-light: #f5f9fc;
+	--rcx-color-surface-room: #f5f9fc;
+	--rcx-color-surface-tint: #e8eef5;
+	--rcx-color-surface-neutral: #ffffff;
+	--rcx-color-font-default: #1e293b;
+	--rcx-color-font-secondary-info: #64748b;
+	--rcx-color-font-titles-labels: #1e293b;
+	--rcx-color-stroke-extra-light: #e9eaeb;
+	--rcx-color-stroke-light: #e3ebf7;
+
+	/* -- brand (not a Fuselage token — custom, for L2/L3 Tailwind theme) */
+	--ep-color-brand-50: #f1f4f9;
+	--ep-color-brand-100: #dfe6f1;
+	--ep-color-brand-200: #c0cde3;
+	--ep-color-brand-300: #99afd1;
+	--ep-color-brand-400: #7291c0;
+	--ep-color-brand-500: #4f75b0;
+	--ep-color-brand-600: #3e5c8a;
+	--ep-color-brand-700: #365078;
+	--ep-color-brand-800: #293d5b;
+	--ep-color-brand-900: #1c2a3f;
+
+	/* -- accent / amber (logo mark only — never used for interactive states) */
+	--ep-color-accent-50: #fdf8ec;
+	--ep-color-accent-100: #fbefd5;
+	--ep-color-accent-200: #f7deab;
+	--ep-color-accent-300: #f2ca78;
+	--ep-color-accent-400: #eeb644;
+	--ep-color-accent-500: #e9a416;
+	--ep-color-accent-600: #b88111;
+	--ep-color-accent-700: #9f6f0f;
+	--ep-color-accent-800: #79550b;
+	--ep-color-accent-900: #543b08;
+}
+
+/* Reassert the same light-mode values explicitly on Fuselage's own dynamic
+   theming selector, so this block has identical selector specificity to the
+   runtime <PaletteStyleTag theme={theme} selector='.rcx-content--main, .rcx-tile' />
+   and only needs source order (not specificity) to win. */
+.rcx-content--main,
+.rcx-tile {
+	--rcx-color-surface-light: #f5f9fc;
+	--rcx-color-surface-room: #f5f9fc;
+	--rcx-color-surface-tint: #e8eef5;
+	--rcx-color-surface-neutral: #ffffff;
+	--rcx-color-font-default: #1e293b;
+	--rcx-color-font-secondary-info: #64748b;
+	--rcx-color-font-titles-labels: #1e293b;
+	--rcx-color-stroke-extra-light: #e9eaeb;
+	--rcx-color-stroke-light: #e3ebf7;
+}
+
+/* Sidebar (classic `.rcx-sidebar--main`) and the newer secondary-nav side
+   panel (`.rcx-sidepanel`, feature-flag 'secondarySidebar') are grouped
+   together deliberately, matching the existing selector grouping already used
+   by MainLayoutStyleTags.tsx's dark PaletteStyleTag. The dashboard mockup
+   actually shows two adjacent tones (a narrower icon rail vs. a wider
+   room-list panel) within this region — collapsing both to one value here is
+   an intentional L0 simplification; splitting them precisely requires
+   knowing which DOM node renders which class, which is GATE 5 (component
+   rewrite) territory, not a global token concern. Flagged for a GATE 5
+   decision. */
+.rcx-sidebar--main,
+.rcx-sidepanel {
+	--rcx-color-surface-sidebar: #0f1728;
+}
+
+.rcx-navbar {
+	--rcx-color-surface-sidebar: #0a2535;
+}
