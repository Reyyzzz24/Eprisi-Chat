@@ -0,0 +1,236 @@
+#!/usr/bin/env node
+/**
+ * GATE 6a — automated visual diff of the Eprisi theme against the source
+ * mockups (mockups/rocketchat/{login,dashboard}.jpg).
+ *
+ * The mockups are hand-drawn compositions, not screenshots, so a raw
+ * pixel-diff percentage is expected to be high and is not the signal that
+ * matters (see REDESIGN_PROMPT.md GATE 6). This script produces that number
+ * for reference, but the real output is `differences` in report.json — a
+ * structured, human-authored list of concrete deviations (color, spacing,
+ * radius, font-size, position) found by comparing the actual screenshots
+ * against the mockups side by side. This script only captures the
+ * screenshots and the pixel-diff overlay; the `differences` array below is
+ * filled in by hand after visual review, not computed.
+ *
+ * Usage: node scripts/visual-diff.mjs [baseURL]
+ *   baseURL defaults to http://localhost:3000 (a running `yarn dev` server).
+ *
+ * Requires an admin account already provisioned (see VERIFY.md for how this
+ * fork's test instance was seeded) — TEST_ADMIN_USER / TEST_ADMIN_PASS below
+ * must be able to log in for the authenticated /home capture to work.
+ */
+import { execFileSync } from 'node:child_process';
+import { mkdirSync, writeFileSync, readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { chromium } from '@playwright/test';
+import pixelmatch from 'pixelmatch';
+import { PNG } from 'pngjs';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const ROOT = path.resolve(__dirname, '..');
+const OUT_DIR = path.join(ROOT, '.visual');
+// mockups/ lives in the eprisi-workspace parent dir, one level above this
+// rc-fork checkout, alongside the eprisi-theme/ tokens directory.
+const MOCKUPS_DIR = path.join(ROOT, '..', 'mockups', 'rocketchat');
+
+const BASE_URL = process.argv[2] || process.env.VISUAL_DIFF_BASE_URL || 'http://localhost:3000';
+const TEST_ADMIN_USER = process.env.VISUAL_DIFF_ADMIN_USER || 'eprisiadmin';
+const TEST_ADMIN_PASS = process.env.VISUAL_DIFF_ADMIN_PASS || 'EprisiVerify14#Ok';
+
+const VIEWPORTS = [
+	{ name: 'desktop', width: 1440, height: 900 },
+	{ name: 'mobile', width: 390, height: 844 },
+];
+
+const SCREENS = [
+	{ name: 'login', path: '/', authenticated: false, baseline: 'login.jpg' },
+	{ name: 'home', path: '/home', authenticated: true, baseline: 'dashboard.jpg' },
+];
+
+mkdirSync(OUT_DIR, { recursive: true });
+
+/** Convert+crop a JPG mockup to a PNG matching a given viewport, via macOS `sips`.
+ * Mockups are 1440x1024 (full composition); the desktop viewport (1440x900)
+ * only needs the top crop. There is no mobile-specific mockup — see the
+ * `mobile-baseline` note attached to each mobile screen in report.json. */
+function baselineAsPng(jpgName, width, height) {
+	const jpgPath = path.join(MOCKUPS_DIR, jpgName);
+	const pngPath = path.join(OUT_DIR, `_baseline-${path.basename(jpgName, '.jpg')}.png`);
+	execFileSync('sips', ['-s', 'format', 'png', jpgPath, '--out', pngPath], { stdio: 'pipe' });
+	const png = PNG.sync.read(readFileSync(pngPath));
+	const cropped = new PNG({ width, height });
+	PNG.bitblt(png, cropped, 0, 0, Math.min(width, png.width), Math.min(height, png.height), 0, 0);
+	return cropped;
+}
+
+/** Log in once in a throwaway context and return its storageState, so every
+ * authenticated screen capture below starts from a clean context seeded with
+ * that state rather than reusing/re-navigating a single shared page. Reusing
+ * one page across an unauthenticated screenshot and a subsequent login was
+ * found to silently leave the app on the login form (Meteor/DDP client state
+ * left over from the first navigation) — fresh contexts per screen sidestep
+ * that entirely and make each capture independent/order-proof. */
+async function getAuthenticatedStorageState(browser) {
+	const context = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+	const page = await context.newPage();
+	await page.goto(BASE_URL, { waitUntil: 'networkidle', timeout: 60000 });
+	await page.getByPlaceholder('example@example.com').fill(TEST_ADMIN_USER);
+	await page.locator('input[type="password"]').fill(TEST_ADMIN_PASS);
+	await page.getByRole('button', { name: 'Login' }).click();
+	await page.waitForTimeout(3000);
+	const stillOnLoginForm = (await page.getByRole('heading', { name: 'Login' }).count()) > 0;
+	if (stillOnLoginForm) {
+		throw new Error(
+			`Login did not succeed for ${TEST_ADMIN_USER} — still on the login form after submit. Check VISUAL_DIFF_ADMIN_USER/PASS or that the test admin account exists (see VERIFY.md).`,
+		);
+	}
+	const state = await context.storageState();
+	await context.close();
+	return state;
+}
+
+async function main() {
+	const browser = await chromium.launch();
+	const report = { generatedAt: new Date().toISOString(), baseURL: BASE_URL, results: [] };
+	const authState = await getAuthenticatedStorageState(browser);
+
+	for (const viewport of VIEWPORTS) {
+		for (const screen of SCREENS) {
+			const context = await browser.newContext({
+				viewport: { width: viewport.width, height: viewport.height },
+				storageState: screen.authenticated ? authState : undefined,
+			});
+			const page = await context.newPage();
+			await page.goto(`${BASE_URL}${screen.path}`, { waitUntil: 'networkidle', timeout: 60000 });
+			await page.waitForTimeout(screen.authenticated ? 4000 : 1500);
+			const actualPath = path.join(OUT_DIR, `${screen.name}-${viewport.name}-actual.png`);
+			await page.screenshot({ path: actualPath });
+			await context.close();
+			report.results.push(diffAgainstBaseline(screen, viewport, actualPath));
+		}
+	}
+
+	await browser.close();
+
+	// Hand-authored structured findings from visual review of the captures
+	// above against the mockups — see GATE 6 report in chat for the review
+	// session these came from. Keyed by "<screen>-<viewport>" to match
+	// report.results[].id.
+	report.differences = HAND_REVIEWED_DIFFERENCES;
+
+	writeFileSync(path.join(OUT_DIR, 'report.json'), JSON.stringify(report, null, 2));
+	console.log(`Wrote ${report.results.length} captures and report.json to ${OUT_DIR}`);
+}
+
+function diffAgainstBaseline(screen, viewport, actualPath) {
+	const id = `${screen.name}-${viewport.name}`;
+	const result = { id, screen: screen.name, viewport: viewport.name, actualPath };
+
+	if (viewport.name !== 'desktop') {
+		result.note = 'No mobile-specific mockup exists (mockups/rocketchat only has one 1440x1024 composition per screen) — mobile capture is for manual/structural review only, not pixel-diffed.';
+		return result;
+	}
+
+	const actual = PNG.sync.read(readFileSync(actualPath));
+	const baseline = baselineAsPng(screen.baseline, viewport.width, viewport.height);
+	const diff = new PNG({ width: viewport.width, height: viewport.height });
+	const diffPixels = pixelmatch(actual.data, baseline.data, diff.data, viewport.width, viewport.height, { threshold: 0.15 });
+	const diffPath = path.join(OUT_DIR, `${id}-diff.png`);
+	writeFileSync(diffPath, PNG.sync.write(diff));
+
+	result.baselinePath = path.join(MOCKUPS_DIR, screen.baseline);
+	result.diffPath = diffPath;
+	result.diffPixelPercent = Number(((diffPixels / (viewport.width * viewport.height)) * 100).toFixed(2));
+	result.note = 'Mockup is a hand-drawn composition, not a screenshot — a high raw percentage here is expected; see report.differences for the actual structured findings.';
+	return result;
+}
+
+const HAND_REVIEWED_DIFFERENCES = [
+	{
+		id: 'sidebar-surface-color-cascade-loss',
+		severity: 'fixed',
+		screens: ['home-desktop', 'home-mobile'],
+		category: 'color',
+		summary:
+			"Navbar/sidebar rendered as Fuselage's forced-dark gray (#2f343d / navbar #3f444c) instead of the Eprisi navy tokens (#0f1728 / #0a2535).",
+		rootCause:
+			"Fuselage's <PaletteStyleTag> inserts a `#sidebar-palette` <style> tag at runtime targeting `.rcx-sidebar--main, .rcx-sidepanel, .rcx-navbar` with its own dark surface-sidebar value. It lands after eprisi-tokens.css in the DOM, so on tied selector specificity it won by source order — exactly the risk GATE 2's own comment flagged as unverified.",
+		fix: 'Doubled the selector specificity in eprisi-tokens.css (`.rcx-sidebar--main.rcx-sidebar--main`, `.rcx-navbar.rcx-navbar`) per the project convention of escalating specificity before `!important`. Verified via computed style: sidebarBg now rgb(15,23,40), navbarBg rgb(10,37,53) — exact token match.',
+	},
+	{
+		id: 'shadcn-form-controls-missing-font-family',
+		severity: 'open',
+		screens: ['login-desktop', 'login-mobile'],
+		category: 'font-family',
+		summary:
+			'The GATE 4 shadcn Button (and likely Input/other form controls) renders in the browser default control font (computed font-family: "Arial") instead of IBM Plex Sans.',
+		rootCause:
+			'eprisi-tailwind.css never defines a font-family utility mapped to --rcx-font-family-sans/--ep-font-family-heading, and button.tsx only applies ep-text-p1/ep-font-medium (size/weight), never a font-family class. Browsers do not inherit font-family into <button> by default, so with no explicit class it falls back to the OS UI control font.',
+		suggestedFix:
+			'Add a `font-sans`/`ep-font-sans` Tailwind utility in eprisi-tailwind.css mapped to var(--rcx-font-family-sans), then apply it in both local shadcn Button implementations (apps/meteor/client/components/ui/button.tsx and packages/web-ui-registration/src/components/ui/button.tsx) and audit Input for the same gap.',
+		deferred: true,
+		deferralReason:
+			'Root cause traces to GATE 3 (Tailwind theme setup), and a full fix touches component primitives shared across two separate packages — larger than GATE 6 verification scope. Reported for a scoping decision rather than fixed inline.',
+	},
+	{
+		id: 'login-branding-not-customized',
+		severity: 'open',
+		screens: ['login-desktop', 'login-mobile'],
+		category: 'content',
+		summary:
+			'Login screen still shows the literal Rocket.Chat wordmark/logo and generic "Login" heading with no subtitle, whereas the mockup shows a custom "EPRISI Chat" wordmark (amber speech-bubble icon), heading "Login to Eprisi Chat", and a subtitle.',
+		rootCause:
+			"The logo and page copy are pulled from RC's own branding assets/settings (Assets_logo, translation strings) and workspace-name-driven templates, not something GATE 4's component rewrite controls directly.",
+		note: 'Not a CSS defect — needs a product decision on whether/how to inject custom logo assets and copy overrides (admin asset upload vs. a hardcoded brand constant).',
+		deferred: true,
+	},
+	{
+		id: 'login-aside-hero-content-gap',
+		severity: 'open',
+		screens: ['login-desktop'],
+		category: 'content',
+		summary:
+			'Mockup\'s right-panel aside shows a photographic hero image with an overlay and custom marketing copy ("Secure Real-time Collaboration..."); actual renders a plain solid navy panel with the generic, workspace-name-driven "Welcome to {org} workspace / Powered by Rocket.Chat" text.',
+		rootCause:
+			"HorizontalTemplate's aside content is data-driven from the workspace name setting — there is no existing settings slot for a hero image or custom marketing copy.",
+		note: 'Reported as a mockup-vs-product gap per the GATE 5/6 rule (don\'t invent new settings/features without a decision) rather than built.',
+		deferred: true,
+	},
+	{
+		id: 'login-org-name-double-workspace-text',
+		severity: 'non-issue',
+		screens: ['login-desktop', 'home-desktop'],
+		category: 'content',
+		summary: 'Aside/Home heading reads "Welcome to Eprisi Workspace workspace" (word "workspace" doubled).',
+		rootCause:
+			'Test-data artifact: the seed script named the organization "Eprisi Workspace" during the setup wizard, and RC\'s own template is "Welcome to {name} workspace" — the duplication is from the test org name choice, not a template or theme bug.',
+		note: 'No code change needed; flagging only so it is not mistaken for a real defect when reading the screenshots.',
+	},
+	{
+		id: 'sidebar-channel-avatar-vs-hash-icon',
+		severity: 'open',
+		screens: ['home-desktop', 'home-mobile'],
+		category: 'component-style',
+		summary:
+			'Actual sidebar shows a colored letter-avatar tile ("G") for #general; mockup shows a plain "#" hash icon with no avatar tile, giving a cleaner/flatter row.',
+		rootCause: 'Driven by the existing sidebarDisplayAvatar user/admin preference, not a new feature — RC already supports both display modes.',
+		suggestedFix: 'Consider changing the *default* value of the sidebarDisplayAvatar setting to match the mockup, rather than a CSS change.',
+		deferred: true,
+	},
+	{
+		id: 'no-multi-workspace-icon-rail',
+		severity: 'non-issue',
+		screens: ['home-desktop', 'home-mobile'],
+		category: 'layout',
+		summary: "Mockup shows a Slack-style multi-workspace icon rail (E/HQ/PR/+ icons); Rocket.Chat has no multi-workspace concept.",
+		note: 'Already resolved as a reported gap in GATE 5 (see eprisi-tokens.css comment) — repeated here for completeness of the GATE 6 record, not a new finding.',
+	},
+];
+
+main().catch((err) => {
+	console.error(err);
+	process.exit(1);
+});
