+		<div className='ep-flex ep-flex-col ep-gap-2'>
+			<Skeleton className='ep-h-4 ep-w-24' />
+			<Skeleton className='ep-h-4 ep-w-40' />
+			<Skeleton className='ep-h-11 ep-w-full' />
+			<Skeleton className='ep-h-3 ep-w-32' />
+		</div>
+		<Skeleton className='ep-h-11 ep-w-full' />
+	</form>
 );
 
 export default FormSkeleton;
