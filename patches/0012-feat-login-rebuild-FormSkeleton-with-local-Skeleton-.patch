-			<FieldRow>
-				<InputBoxSkeleton />
-			</FieldRow>
-			<FieldHint>
-				<Skeleton />
-			</FieldHint>
-		</Field>
-		<FormFooter>
-			<Skeleton />
-		</FormFooter>
-	</Form>
+	<form aria-busy className='ep-flex ep-w-full ep-max-w-[520px] ep-flex-col ep-gap-6'>
