# Server-side only — resolved inside the BFF (app/api/rc/**), never sent to the browser.
# Points at Rocket.Chat's internal network address (e.g. the "rocketchat" service
# name in docker-compose), not its public hostname.
RC_INTERNAL_URL=http://rocketchat:3000

# Client-side (NEXT_PUBLIC_*) — safe to expose, used directly by the browser.
#
# GATE 8 finding: Next.js inlines NEXT_PUBLIC_* values into the browser
# bundle at BUILD time, not at container start time. Setting these in
# docker-compose's `environment:` block (or Dokploy's env UI) has NO effect
# on already-built client-side code — NEXT_PUBLIC_RC_WS_URL in particular is
# read ONLY client-side (lib/rc/ddp.ts), so if it's wrong, the DDP
# connection silently targets the wrong host and nothing realtime works.
# These two must be passed as Docker build ARGs (see Dockerfile) matching
# the FINAL public domain before `docker build`, and the image must be
# rebuilt (not just restarted) whenever these values change.
NEXT_PUBLIC_RC_WS_URL=wss://private-chat.eprisi.com/websocket
NEXT_PUBLIC_RC_PUBLIC_URL=https://private-chat.eprisi.com

# Session cookie signing secret — generate with `openssl rand -base64 32`.
# Never commit the real value; in Dokploy this lives in the secret store, not .env.
SESSION_SECRET=

# --- Keycloak SSO (GATE 1 decision option (a) — see SCOPE.md, UNTESTED end-to-end) ---
# Leave all three unset to disable the "Login with Keycloak" button entirely;
# password login keeps working either way.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
# Auth.js's own secret (unrelated to SESSION_SECRET above) — generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://chat.eprisi.com

# Rocket.Chat service account used ONLY for the Keycloak->RC token exchange
# (looks up the RC user, then calls users.createToken on its behalf). Needs
# the `user-generate-access-token` permission granted to its role via RC's
# Admin UI. See lib/rc/serviceAccount.ts and SECURITY.md.
RC_SERVICE_ACCOUNT_USER=
RC_SERVICE_ACCOUNT_PASS=

# Must be set to the SAME value as the Rocket.Chat server's own
# CREATE_TOKENS_FOR_USERS_SECRET env var (set on the `rocketchat` service in
# docker-compose.yml, GATE 8). Confirmed working manually against the local
# dev instance during GATE 4 — see SCOPE.md.
CREATE_TOKENS_FOR_USERS_SECRET=

# --- Local dev overrides (see spike/config.ts for the same defaults) ---
# RC_INTERNAL_URL=http://localhost:3000
# NEXT_PUBLIC_RC_WS_URL=ws://localhost:3000
# NEXT_PUBLIC_RC_PUBLIC_URL=http://localhost:3000
