@@ -14,3 +14,8 @@
 @import url('imports/general/theme_old.css');
 @import url('./rocketchat.font.css');
 @import url('../../../node_modules/@rocket.chat/fuselage/dist/fuselage.css');
+
+/* Eprisi theme (L0) — must stay last so it wins the cascade over fuselage.css
+   by source order alone, without !important. See eprisi-theme/README.md. */
+@import url('imports/general/eprisi-fonts.css');
+@import url('imports/general/eprisi-tokens.css');
