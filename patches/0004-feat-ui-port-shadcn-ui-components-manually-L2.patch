+import type { ReactElement } from 'react';
+import { useForm } from 'react-hook-form';
+
+import { Avatar, AvatarFallback, AvatarImage } from './avatar';
+import { Badge } from './badge';
+import { Button } from './button';
+import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from './card';
+import { Checkbox } from './checkbox';
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle, DialogTrigger } from './dialog';
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from './dropdown-menu';
+import { Form, FormControl, FormField, FormItem, FormLabel, FormMessage } from './form';
+import { Input } from './input';
+import { Label } from './label';
+import { ScrollArea } from './scroll-area';
+import { Separator } from './separator';
+import { Skeleton } from './skeleton';
+import { Tabs, TabsContent, TabsList, TabsTrigger } from './tabs';
+import { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from './tooltip';
+
+/**
+ * GATE 3 proof-of-compile page — exercises every shadcn component ported in
+ * this gate so a Meteor dev build failure surfaces here instead of silently
+ * in an unrelated screen. Temporary: removed in GATE 7 (see REDESIGN_PROMPT.md).
+ */
+type ShowcaseFormValues = { email: string };
+
+const ShowcaseForm = (): ReactElement => {
+	const form = useForm<ShowcaseFormValues>({ defaultValues: { email: '' } });
+	return (
+		<Form {...form}>
+			<form className='ep-flex ep-flex-col ep-gap-4' onSubmit={form.handleSubmit(() => undefined)}>
+				<FormField
+					control={form.control}
+					name='email'
+					rules={{ required: 'Email is required' }}
+					render={({ field }) => (
+						<FormItem>
+							<FormLabel>Email</FormLabel>
+							<FormControl>
+								<Input placeholder='you@eprisi.com' {...field} />
+							</FormControl>
+							<FormMessage />
+						</FormItem>
+					)}
+				/>
+				<Button type='submit'>Submit</Button>
+			</form>
+		</Form>
+	);
+};
+
+const UiShowcase = (): ReactElement => (
+	<TooltipProvider>
+		<div className='ep-flex ep-min-h-screen ep-flex-col ep-gap-8 ep-bg-surface-light ep-p-8 ep-font-sans'>
+			<h1 className='ep-font-heading ep-text-h1 ep-text-font-default'>Eprisi UI showcase (GATE 3)</h1>
+
+			<section className='ep-flex ep-flex-wrap ep-items-center ep-gap-3'>
+				<Button>Default</Button>
+				<Button variant='outline'>Outline</Button>
+				<Button variant='ghost'>Ghost</Button>
+				<Button variant='link'>Link</Button>
+				<Button size='sm'>Small</Button>
+				<Button size='lg'>Large</Button>
+				<Button disabled>Disabled</Button>
+			</section>
+
+			<section className='ep-flex ep-flex-wrap ep-items-center ep-gap-3'>
+				<Badge>Default</Badge>
+				<Badge variant='secondary'>Secondary</Badge>
+				<Badge variant='outline'>Outline</Badge>
+			</section>
+
+			<section className='ep-flex ep-items-center ep-gap-4'>
+				<Avatar>
+					<AvatarImage src='/avatar.png' alt='avatar' />
+					<AvatarFallback>EP</AvatarFallback>
+				</Avatar>
+				<div className='ep-flex ep-items-center ep-gap-2'>
+					<Checkbox id='terms' />
+					<Label htmlFor='terms'>Accept terms</Label>
+				</div>
+				<Skeleton className='ep-h-10 ep-w-32' />
+			</section>
+
+			<Separator />
+
+			<Card className='ep-max-w-md'>
+				<CardHeader>
+					<CardTitle>Card title</CardTitle>
+					<CardDescription>Card description sampled from the mockup layout.</CardDescription>
+				</CardHeader>
+				<CardContent>
+					<ShowcaseForm />
+				</CardContent>
+				<CardFooter>
+					<Button variant='outline'>Cancel</Button>
+				</CardFooter>
+			</Card>
+
+			<section className='ep-flex ep-items-center ep-gap-4'>
+				<Dialog>
+					<DialogTrigger asChild>
+						<Button variant='outline'>Open dialog</Button>
+					</DialogTrigger>
+					<DialogContent>
+						<DialogHeader>
+							<DialogTitle>Dialog title</DialogTitle>
+							<DialogDescription>Dialog description.</DialogDescription>
+						</DialogHeader>
+					</DialogContent>
+				</Dialog>
+
+				<DropdownMenu>
+					<DropdownMenuTrigger asChild>
+						<Button variant='outline'>Open menu</Button>
+					</DropdownMenuTrigger>
+					<DropdownMenuContent>
+						<DropdownMenuItem>Item one</DropdownMenuItem>
+						<DropdownMenuItem>Item two</DropdownMenuItem>
+					</DropdownMenuContent>
+				</DropdownMenu>
+
+				<Tooltip>
+					<TooltipTrigger asChild>
+						<Button variant='ghost'>Hover me</Button>
+					</TooltipTrigger>
+					<TooltipContent>Tooltip content</TooltipContent>
+				</Tooltip>
+			</section>
+
+			<Tabs defaultValue='one' className='ep-max-w-md'>
+				<TabsList>
+					<TabsTrigger value='one'>Tab one</TabsTrigger>
+					<TabsTrigger value='two'>Tab two</TabsTrigger>
+				</TabsList>
+				<TabsContent value='one'>Tab one content</TabsContent>
+				<TabsContent value='two'>Tab two content</TabsContent>
+			</Tabs>
+
+			<ScrollArea className='ep-h-32 ep-max-w-md ep-rounded-md ep-border ep-border-stroke-extra-light ep-p-4'>
+				{Array.from({ length: 20 }, (_, i) => (
+					<p key={i} className='ep-text-p1'>
+						Scrollable row {i + 1}
+					</p>
+				))}
+			</ScrollArea>
+		</div>
+	</TooltipProvider>
+);
+
+export default UiShowcase;
